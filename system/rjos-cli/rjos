#!/usr/bin/env bash
# =============================================================================
# RJOS CLI — rjos
# Ferramenta de linha de comando do RJOS para gerenciar o sistema
#
# Uso:
#   rjos install <pacote>    Instala um pacote
#   rjos remove  <pacote>    Remove um pacote
#   rjos search  <termo>     Pesquisa pacotes
#   rjos update              Atualiza lista de pacotes
#   rjos upgrade             Atualiza todos os pacotes
#   rjos info    <pacote>    Informações sobre um pacote
#   rjos list                Lista pacotes instalados
#   rjos flatpak <args>      Passa para flatpak
#   rjos version             Versão do RJOS
#   rjos sysinfo             Informações do sistema
# =============================================================================

set -euo pipefail

# ─── Cores ────────────────────────────────────────────────────────────────────
RED='\033[0;31m';   GREEN='\033[0;32m';  YELLOW='\033[1;33m'
CYAN='\033[0;36m';  BOLD='\033[1m';      DIM='\033[2m';  NC='\033[0m'

RJOS_VERSION="1.0.0"
RJOS_CODENAME="Nebula"

# ─── Helpers ──────────────────────────────────────────────────────────────────
info()    { echo -e "${CYAN}rjos${NC}  $*"; }
ok()      { echo -e "${GREEN}✔${NC}  $*"; }
warn()    { echo -e "${YELLOW}!${NC}  $*"; }
error()   { echo -e "${RED}✘${NC}  $*" >&2; exit 1; }
step()    { echo -e "${BOLD}→${NC}  $*"; }

require_root() {
  [[ $EUID -ne 0 ]] && { error "Este comando requer sudo: sudo rjos $*"; }
}

apt_ok() {
  command -v apt-get &>/dev/null
}

# ─── Banner ────────────────────────────────────────────────────────────────────
banner() {
  echo -e "${CYAN}  ██████╗      ██╗ ██████╗ ███████╗${NC}"
  echo -e "${CYAN}  ██╔══██╗     ██║██╔═══██╗██╔════╝${NC}"
  echo -e "${CYAN}  ██████╔╝     ██║██║   ██║███████╗${NC}"
  echo -e "${CYAN}  ██╔══██╗██   ██║██║   ██║╚════██║${NC}"
  echo -e "${CYAN}  ██║  ██║╚█████╔╝╚██████╔╝███████║${NC}"
  echo -e "${CYAN}  ╚═╝  ╚═╝ ╚════╝  ╚═════╝ ╚══════╝${NC}"
  echo -e "  ${DIM}v${RJOS_VERSION} — ${RJOS_CODENAME}${NC}"
  echo ""
}

# ─── Comandos ─────────────────────────────────────────────────────────────────

cmd_install() {
  [[ $# -eq 0 ]] && { warn "Uso: rjos install <pacote> [pacote2...]"; exit 1; }

  step "Instalando: $*"

  # Verifica se Flatpak tem o pacote (prioridade em apps GUI)
  for pkg in "$@"; do
    if flatpak search --columns=application "$pkg" 2>/dev/null | grep -qi "$pkg"; then
      info "Encontrado no Flatpak: $pkg"
      flatpak install --noninteractive flathub "$pkg" 2>/dev/null && ok "$pkg instalado via Flatpak" && continue
    fi

    # APT como fallback
    if apt_ok; then
      DEBIAN_FRONTEND=noninteractive apt-get install -y "$pkg" && \
        ok "$pkg instalado via APT" || \
        warn "Não encontrado: $pkg (tente: rjos search $pkg)"
    fi
  done
}

cmd_remove() {
  [[ $# -eq 0 ]] && { warn "Uso: rjos remove <pacote>"; exit 1; }
  step "Removendo: $*"
  DEBIAN_FRONTEND=noninteractive apt-get remove -y "$@" && ok "Removido: $*"
}

cmd_search() {
  [[ $# -eq 0 ]] && { warn "Uso: rjos search <termo>"; exit 1; }

  echo ""
  echo -e "${BOLD}Resultados para: $*${NC}"
  echo ""

  # APT
  if apt_ok; then
    echo -e "${CYAN}── APT (sistema) ──${NC}"
    apt-cache search "$@" | head -20 | while IFS=' - ' read -r pkg desc; do
      printf "  %-30s %s\n" "$pkg" "${desc:0:60}"
    done
    echo ""
  fi

  # Flatpak
  if command -v flatpak &>/dev/null; then
    echo -e "${CYAN}── Flatpak (apps) ──${NC}"
    flatpak search "$@" --columns=name,description,application 2>/dev/null | \
      head -15 || true
    echo ""
  fi
}

cmd_update() {
  step "Atualizando lista de pacotes..."
  apt-get update -qq && ok "Lista atualizada"

  # Flatpak
  if command -v flatpak &>/dev/null; then
    step "Atualizando Flatpak..."
    flatpak update --noninteractive 2>/dev/null && ok "Flatpak atualizado" || true
  fi
}

cmd_upgrade() {
  step "Verificando atualizações disponíveis..."
  apt-get update -qq

  local count
  count=$(apt list --upgradable 2>/dev/null | grep -c upgradable || true)

  if [[ $count -eq 0 ]]; then
    ok "Sistema atualizado. Nenhuma atualização disponível."
    return
  fi

  info "$count atualização(ões) disponível(is)"
  echo ""

  # Mostra lista resumida
  apt list --upgradable 2>/dev/null | grep -v "Listing" | head -20

  echo ""
  read -rp "Atualizar tudo? [S/n] " resp
  [[ "$resp" =~ ^[Nn]$ ]] && { info "Cancelado."; exit 0; }

  DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
  ok "Sistema atualizado!"

  # Flatpak
  if command -v flatpak &>/dev/null; then
    step "Atualizando apps Flatpak..."
    flatpak update --noninteractive
  fi
}

cmd_info() {
  [[ $# -eq 0 ]] && { warn "Uso: rjos info <pacote>"; exit 1; }
  apt-cache show "$1" 2>/dev/null | grep -E "^(Package|Version|Description|Installed-Size|Maintainer):" \
    || flatpak info "$1" 2>/dev/null \
    || error "Pacote não encontrado: $1"
}

cmd_list() {
  echo ""
  echo -e "${BOLD}Pacotes instalados (APT)${NC}"
  dpkg --get-selections | grep -v deinstall | awk '{print $1}' | \
    grep -v "^lib" | head -50
  echo ""

  if command -v flatpak &>/dev/null; then
    echo -e "${BOLD}Apps instalados (Flatpak)${NC}"
    flatpak list --app --columns=name,application 2>/dev/null | head -30 || true
  fi
}

cmd_sysinfo() {
  banner

  # CPU
  local cpu
  cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)

  # RAM
  local mem_total mem_free mem_used
  mem_total=$(grep MemTotal /proc/meminfo | awk '{print $2}')
  mem_free=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
  mem_used=$(( (mem_total - mem_free) / 1024 ))
  mem_total=$(( mem_total / 1024 ))

  # Disco
  local disk
  disk=$(df -h / 2>/dev/null | awk 'NR==2{print $4" livre de "$2}')

  # Kernel
  local kernel
  kernel=$(uname -r)

  # Uptime
  local uptime_str
  uptime_str=$(uptime -p 2>/dev/null || cat /proc/uptime | awk '{printf "%d min", $1/60}')

  echo -e "  ${BOLD}Sistema${NC}"
  echo -e "  Distro:    RJOS ${RJOS_VERSION} (${RJOS_CODENAME})"
  echo -e "  Kernel:    ${kernel}"
  echo -e "  Shell:     ${SHELL}"
  echo ""
  echo -e "  ${BOLD}Hardware${NC}"
  echo -e "  CPU:       ${cpu:-N/A}"
  echo -e "  RAM:       ${mem_used} MB / ${mem_total} MB usados"
  echo -e "  Disco:     ${disk:-N/A}"
  echo ""
  echo -e "  ${BOLD}Runtime${NC}"
  echo -e "  Uptime:    ${uptime_str}"
  echo -e "  Display:   ${WAYLAND_DISPLAY:-${DISPLAY:-N/A}}"
  echo -e "  Desktop:   ${XDG_CURRENT_DESKTOP:-RJOS}"
  echo ""
}

cmd_version() {
  echo "RJOS CLI ${RJOS_VERSION} (${RJOS_CODENAME})"
  echo "Base: Debian Bookworm"
  echo "Compositor: Wayland/wlroots"
}

cmd_help() {
  banner
  echo "  Gerenciamento de pacotes:"
  echo "    rjos install <pkg>    Instala pacote (APT ou Flatpak)"
  echo "    rjos remove  <pkg>    Remove pacote"
  echo "    rjos search  <termo>  Pesquisa pacotes"
  echo "    rjos update           Atualiza lista de pacotes"
  echo "    rjos upgrade          Atualiza todos os pacotes"
  echo "    rjos info    <pkg>    Informações do pacote"
  echo "    rjos list             Lista pacotes instalados"
  echo ""
  echo "  Sistema:"
  echo "    rjos sysinfo          Informações do sistema"
  echo "    rjos version          Versão do RJOS"
  echo ""
  echo "  Exemplos:"
  echo "    sudo rjos install firefox"
  echo "    sudo rjos upgrade"
  echo "    rjos search vlc"
  echo "    rjos sysinfo"
}

# ─── Main ──────────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    install)  require_root; cmd_install "$@" ;;
    remove)   require_root; cmd_remove "$@" ;;
    search)   cmd_search "$@" ;;
    update)   require_root; cmd_update ;;
    upgrade)  require_root; cmd_upgrade ;;
    info)     cmd_info "$@" ;;
    list)     cmd_list ;;
    sysinfo)  cmd_sysinfo ;;
    version)  cmd_version ;;
    help|--help|-h) cmd_help ;;
    *)
      warn "Comando desconhecido: $cmd"
      echo "Execute 'rjos help' para ver os comandos disponíveis."
      exit 1
      ;;
  esac
}

main "$@"
